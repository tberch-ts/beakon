# ---- Core ----
NODE_ENV=production
PORT=3000
# Public base URL of this deployment (used in alert-confirmation links and the
# report URLs handed back to the CRM).
BASE_URL=https://beakon.fly.dev
# Long random string for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=changeme-to-a-long-random-string

# ---- Identity: Google sign-in via the marketingCRM Firebase project ----
# Beakon is the operator's console. The ONLY people who may sign in are the
# CRM's admins: the same Firebase project (marketingcrm-c5d57), and the `admin`
# custom claim the CRM sets (npm run set-admin there). No password login, no
# admin list here — if the CRM says admin, Beakon agrees.
#
# Server side: the service-account JSON, raw or base64 (the value the CRM uses
# as FIREBASE_SERVICE_ACCOUNT_JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Browser side: the public web config, the CRM's VITE_FIREBASE_* values.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=marketingcrm-c5d57.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=marketingcrm-c5d57
FIREBASE_WEB_APP_ID=
# Google sign-in also needs this deployment's hostname (e.g. beakon.fly.dev) in
# the Firebase project's Authentication → Settings → Authorized domains.

# ---- Monitoring engine: Uptime Kuma (optional) ----
# When set, Beakon mirrors every monitor into Uptime Kuma and consumes its
# heartbeats (HTTP, keyword, ping, TCP port, DNS). When unset, Beakon runs its
# own HTTP + SSL checks. Kuma's status pages are what customers see. See UPTIME-KUMA.md.
KUMA_URL=http://beakon-kuma.internal:3001
KUMA_USERNAME=beakon
KUMA_PASSWORD=
# Only if 2FA is enabled on that Kuma user (a current TOTP code; better to leave 2FA off for this account).
# KUMA_2FA_TOKEN=

# ---- marketingCRM link ----
# Outbound: Beakon posts down/recovered/SSL signals to the CRM.
CRM_API_URL=https://marketing-api.fly.dev
# Must equal SIGNAL_INGEST_TOKEN in the CRM.
CRM_SIGNAL_TOKEN=
# Inbound: the CRM creates clients here at onboarding and asks for search
# grades. Any long random string; must equal BEAKON_API_TOKEN in the CRM.
CRM_WEBHOOK_TOKEN=

# ---- Email (SMTP) ----
# Used for alert emails to a client AND the alert-address confirmation link.
# Unset = logged to console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# The "from" address alerts are sent as (must be a verified sender)
ALERT_FROM="Beakon Alerts <alerts@yourdomain.com>"

# ---- Monitoring ----
# How often the built-in scheduler sweeps active monitors, in seconds
CHECK_INTERVAL_SECONDS=60
# Warn when an SSL certificate expires within this many days
SSL_WARN_DAYS=14
# Request timeout for HTTP checks, in milliseconds
HTTP_TIMEOUT_MS=15000

# ---- Search ladder (optional) ----
# Rung 1 is "a Google Business Profile exists and points at this site". With a
# Places API key Beakon looks the profile up by business name and accepts a
# result whose website is the client's domain; without it, the Place ID comes
# from the CRM (the NFC card) or is typed into the report page.
GOOGLE_PLACES_API_KEY=
