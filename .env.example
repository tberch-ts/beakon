# ---- Core ----
NODE_ENV=production
PORT=3000
# Public base URL of your deployment (used for Stripe redirects & email links)
BASE_URL=https://app.yourdomain.com
# Long random string for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=changeme-to-a-long-random-string

# ---- Identity: Google sign-in via Firebase (the marketingCRM project) ----
# One identity across the CRM portal and Beakon. Use the SAME Firebase project
# as marketingCRM (marketingcrm-c5d57) so a customer's Google account and the
# operator's `admin` custom claim (CRM: npm run set-admin) carry over.
#
# Server side: the service-account JSON, raw or base64 (same value the CRM uses).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Browser side: the public web config. Not secret. Fetch with:
#   firebase apps:sdkconfig WEB --project marketingcrm-c5d57
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=marketingcrm-c5d57.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=marketingcrm-c5d57
FIREBASE_WEB_APP_ID=
# Extra admins by email (comma-separated), in addition to the Firebase `admin` claim.
ADMIN_EMAILS=
# Keep the old email+password form alongside Google. Defaults to on until the
# FIREBASE_* values above are set, then off.
# LEGACY_PASSWORD_LOGIN=true

# ---- Monitoring engine: Uptime Kuma (optional) ----
# When set, Beakon mirrors every monitor into Uptime Kuma and consumes its
# heartbeats (HTTP, keyword, ping, TCP port, DNS). When unset, Beakon runs its
# own HTTP + SSL checks. See UPTIME-KUMA.md.
KUMA_URL=http://beakon-kuma.internal:3001
KUMA_USERNAME=beakon
KUMA_PASSWORD=
# Only if 2FA is enabled on that Kuma user (a current TOTP code; better to leave 2FA off for this account).
# KUMA_2FA_TOKEN=

# ---- marketingCRM link ----
# Outbound: Beakon posts down/recovered/SSL signals to the CRM.
CRM_API_URL=https://marketing-api.fly.dev
# Must equal SIGNAL_INGEST_TOKEN in the CRM.
CRM_SIGNAL_TOKEN=
# Inbound: the CRM calls POST /api/crm/clients here when it onboards a client.
# Any long random string; set the same value as BEAKON_API_TOKEN in the CRM.
CRM_WEBHOOK_TOKEN=

# ---- Email (SMTP) ----
# Works with any SMTP provider. Free options: Brevo (300/day), Resend, Mailgun, etc.
# Used for alert emails AND the alert-address confirmation link. Unset = logged to console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# The "from" address your alerts are sent as (must be a verified sender)
ALERT_FROM="Beakon Alerts <alerts@yourdomain.com>"

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs created in the Stripe dashboard (recurring monthly)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# ---- Plan limits (monitors allowed per plan) ----
# Only monitors a customer adds themselves count. Monitors added by an admin or
# by CRM onboarding are free to the customer.
TRIAL_DAYS=14
LIMIT_TRIAL=5
LIMIT_STARTER=20
LIMIT_AGENCY=100

# ---- Monitoring ----
# How often the built-in scheduler sweeps active monitors, in seconds
CHECK_INTERVAL_SECONDS=60
# Warn when an SSL certificate expires within this many days
SSL_WARN_DAYS=14
# Request timeout for HTTP checks, in milliseconds
HTTP_TIMEOUT_MS=15000

# ---- Search ladder (optional) ----
# Rung 1 is "a Google Business Profile exists and points at this site". With a
# Places API key Beakon looks the profile up by business name and accepts a
# result whose website is the client's domain; without it, the Place ID comes
# from the CRM (the NFC card) or is typed into the report page.
GOOGLE_PLACES_API_KEY=
