# ---- Core ----
NODE_ENV=production
PORT=3000
# Public base URL of your deployment (used for Stripe redirects & email links)
BASE_URL=https://app.yourdomain.com
# Long random string for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=changeme-to-a-long-random-string

# ---- Email (SMTP) ----
# Works with any SMTP provider. Free options: Brevo (300/day), Resend, Mailgun, etc.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# The "from" address your alerts are sent as (must be a verified sender)
ALERT_FROM="Beakon Alerts <alerts@yourdomain.com>"

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs created in the Stripe dashboard (recurring monthly)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# ---- Plan limits (monitors allowed per plan) ----
TRIAL_DAYS=14
LIMIT_TRIAL=5
LIMIT_STARTER=20
LIMIT_AGENCY=100

# ---- Monitoring ----
# How often the scheduler sweeps active monitors, in seconds
CHECK_INTERVAL_SECONDS=60
# Warn when an SSL certificate expires within this many days
SSL_WARN_DAYS=14
# Request timeout for HTTP checks, in milliseconds
HTTP_TIMEOUT_MS=15000
