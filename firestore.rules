rules_version = '2';
// All reads/writes go through Cloud Functions (Admin SDK, which bypasses these
// rules). The browser never touches Firestore directly, so we deny all client
// access. This is the secure default for this architecture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
