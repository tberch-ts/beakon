# functions/.env  — non-secret config, auto-loaded by Firebase Functions.
# Copy to functions/.env and fill in. (Secrets go in Secret Manager, NOT here.)

# Public base URL of your deployed app (used for Stripe redirect URLs)
BASE_URL=https://YOUR_PROJECT.web.app

# Stripe recurring price IDs (created in the Stripe dashboard)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# SMTP (password is a SECRET, set separately — see deploy guide)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
ALERT_FROM="Beakon Alerts <alerts@yourdomain.com>"

# Monitoring tuning
SSL_WARN_DAYS=14
HTTP_TIMEOUT_MS=15000

# Secrets to set via `firebase functions:secrets:set`:
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   SMTP_PASS
